{
  "version": 1,
  "student_relevance": {
    "default": false,
    "rules": [
      {
        "id": "student-origin",
        "description": "Club and submission sources are inherently student content.",
        "when": {
          "field": "origin",
          "match": "equals",
          "patterns": [
            "instagram",
            "highlander_link",
            "manual",
            "submission"
          ]
        },
        "value": true
      },
      {
        "id": "student-audience",
        "description": "An explicitly listed student cohort outranks staff/public cohorts.",
        "when": {
          "field": "audiences",
          "match": "contains",
          "patterns": [
            "student"
          ]
        },
        "value": true
      },
      {
        "id": "restricted-audience",
        "description": "Non-student-only audiences override eligibility language in the body.",
        "when": {
          "all": [
            {
              "field": "audiences",
              "match": "contains",
              "patterns": [
                "faculty",
                "staff",
                "employee",
                "alumni",
                "alumnae",
                "alumnus",
                "parent",
                "famil",
                "retiree",
                "emerit",
                "donor",
                "employer"
              ]
            },
            {
              "not": {
                "field": "audiences",
                "match": "contains",
                "patterns": [
                  "general public",
                  "public",
                  "everyone",
                  "campus community",
                  "all audiences"
                ]
              }
            }
          ]
        },
        "value": false
      },
      {
        "id": "student-eligibility-text",
        "description": "Explicit eligibility or student-org vocabulary; generic activity nouns do not qualify.",
        "when": {
          "field": "text",
          "match": "regex",
          "patterns": [
            "\\bopen to (?:the )?(?:all |any |current |ucr )*students\\b",
            "\\b(?:all|any|current|ucr|undergraduate|graduate|incoming|new|prospective|transfer|international|first-year|first-generation) students\\b",
            "\\bstudents? (?:are |is )?(?:welcome|invited|encouraged)\\b",
            "\\bfor (?:ucr |all |our )?students\\b",
            "\\bstudent (?:organization|org|club|group|body|government|leaders?|life|success center)\\b",
            "\\bundergraduates?\\b",
            "\\b(?:rso|asucr|hackathon|intramural|gbm|greek life|sorority|fraternity)\\b",
            "\\bgeneral (?:body )?meeting\\b",
            "\\bclub (?:meeting|fair|sport|social)\\b"
          ]
        },
        "value": true
      }
    ]
  },
  "content_kind": {
    "default": "other",
    "rules": [
      {
        "id": "fundraiser",
        "description": "Fundraisers take precedence over deadlines and student events.",
        "when": {
          "field": "text",
          "match": "contains",
          "patterns": [
            "fundraiser",
            "fundraising",
            "donate",
            "donation",
            "proceeds",
            "percentage night",
            "bake sale",
            "merch sale",
            "benefit night",
            "gofundme"
          ]
        },
        "value": "fundraiser"
      },
      {
        "id": "student-deadline",
        "description": "Only cutoff language in the title makes the listed time a deadline.",
        "when": {
          "all": [
            {
              "student_relevant": true
            },
            {
              "field": "title",
              "match": "contains",
              "patterns": [
                "deadline",
                "apply by",
                "register by",
                "closing date",
                "last day to",
                "applications due",
                "application due",
                "registration closes"
              ]
            }
          ]
        },
        "value": "student_deadline"
      },
      {
        "id": "student-event",
        "when": {
          "student_relevant": true
        },
        "value": "student_event"
      }
    ]
  },
  "free_food": {
    "field": "text",
    "match": "regex",
    "patterns": [
      "\\b(free food|free pizza|pizza provided|free snacks|snacks provided|refreshments|lunch provided|dinner provided|boba|free drinks)\\b"
    ]
  },
  "examples": [
    {
      "name": "Staff audience beats incidental student mentions",
      "event": {
        "origin": "localist",
        "title": "Provost's Office Hours - Staff",
        "description": "Hear from faculty, staff, and students at UCR.",
        "audiences": [
          "Faculty & Staff"
        ]
      },
      "expected": {
        "content_kind": "other",
        "rule_id": null,
        "student_rule_id": "restricted-audience"
      }
    },
    {
      "name": "Student audience allows a campus event",
      "event": {
        "origin": "localist",
        "title": "Campus Concert",
        "audiences": [
          "International Students"
        ]
      },
      "expected": {
        "content_kind": "student_event",
        "student_rule_id": "student-audience"
      }
    },
    {
      "name": "Explicit eligibility promotes an official event",
      "event": {
        "origin": "localist",
        "title": "Resume Clinic",
        "description": "Open to all students."
      },
      "expected": {
        "content_kind": "student_event",
        "student_rule_id": "student-eligibility-text"
      }
    },
    {
      "name": "Title cutoff is a deadline",
      "event": {
        "origin": "instagram",
        "title": "Officer Applications Due Friday"
      },
      "expected": {
        "content_kind": "student_deadline",
        "rule_id": "student-deadline"
      }
    },
    {
      "name": "A related deadline in the body does not change the event",
      "event": {
        "origin": "instagram",
        "title": "Writing Drop-In Hours",
        "description": "Get help before the campus deadline."
      },
      "expected": {
        "content_kind": "student_event"
      }
    },
    {
      "name": "Fundraiser wins over a cutoff",
      "event": {
        "origin": "instagram",
        "title": "Fundraiser Registration Closes"
      },
      "expected": {
        "content_kind": "fundraiser",
        "rule_id": "fundraiser"
      }
    },
    {
      "name": "Unrecognized official content stays other",
      "event": {
        "origin": "localist",
        "title": "Campus Update"
      },
      "expected": {
        "content_kind": "other",
        "rule_id": null,
        "student_relevant": false
      }
    }
  ]
}
