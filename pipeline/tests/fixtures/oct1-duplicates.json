  {
    "id": "ig_ucr_trc_p3996492409026840966",
    "title": "38th annual Tomás Rivera Conference featuring Luis Valdez",
    "description": "From his roots in Delano as a child of farmworkers to founding El Teatro Campesino and earning the National Medal of Arts, Luis Valdez redefined American theater and cinema.\n\nCatch this icon of Chicano storytelling live on stage for the 38th annual Tomás Rivera Conference at UC Riverside on Oct. 15! 🎬🎭 \n\nInfo: tomasriveraconference.ucr.edu\n\n#LuisValdez #ChicanoCinema #UCRiverside #TomasRiveraConference",
    "starts_at": "2026-10-15T07:00:00+00:00",
    "ends_at": "2026-10-16T07:00:00+00:00",
    "location": "UC Riverside",
